# Local dev env for n8n v2 (ported from v1 .env). Gitignored.
# Run: pnpm exec dotenvx run -f .env.local -- pnpm dev:be

# Local data folder (dotenvx expands $HOME, not ~)
N8N_USER_FOLDER=$HOME/.n8n-dev

# Dev ports: backend 5678, editor 8080 (defaults, set explicitly)
N8N_PORT=5678
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/

# DB / executions (v1 values kept)
DB_SQLITE_POOL_SIZE=5
DB_SQLITE_VACUUM_ON_STARTUP=true
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000
EXECUTIONS_TIMEOUT_MAX=3600
N8N_DATA_TABLES_MAX_SIZE_BYTES=104857600
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Timezone
GENERIC_TIMEZONE=Asia/Jerusalem

# Security / nodes (v1 values kept)
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_GIT_NODE_DISABLE_BARE_REPOS=true
N8N_COMMUNITY_PACKAGES_ENABLED=true
N8N_REINSTALL_MISSING_PACKAGES=true

# API
N8N_PUBLIC_API_DISABLED=false
N8N_PUBLIC_API_SWAGGERUI_DISABLED=true

# Logs: console only in dev
N8N_LOG_OUTPUT=console

# Proxy (no reverse proxy locally)
N8N_PROXY_HOPS=0

# Monitoring / telemetry OFF
N8N_METRICS=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false

# Features ON (flags default off or PostHog-gated; env forces on)
N8N_INSTANCE_AI_WORKFLOW_SUGGESTIONS_ENABLED=true
N8N_AGENT_EVALS_ENABLED=true
N8N_MCP_APPS_ENABLED=true
N8N_TEMPLATES_ENABLED=true
N8N_OTEL_ENABLED=false
N8N_DYNAMIC_BANNERS_ENABLED=false

# Web search for agent: needs SearXNG running at this URL (not started by default).
# Port 8888, not 8080 (editor dev port).
N8N_INSTANCE_AI_SEARXNG_URL=http://localhost:8888
# Sandbox (Daytona / self-hosted sandbox): deferred, not set

# Removed in v2, dropped: N8N_RUNNERS_ENABLED, NODE_FUNCTION_ALLOW_BUILTIN,
# NODE_FUNCTION_ALLOW_EXTERNAL, N8N_EDITOR_BASE_URL, WEBHOOK_URL, NODE_ENV,
# N8N_LOG_OUTPUT=file (see BREAKING-CHANGES / deprecation.service.ts)

# -----------------------------------------------------------------------------
# Local admin login lives in .env.secrets.local (gitignored, not committed)
# -----------------------------------------------------------------------------

# --- v2 additions (2026-10-11), see v2-docs/patch-inventory.md ---
N8N_ENABLED_MODULES=agent-evals,promotions
N8N_LICENSE_AUTO_RENEW_ENABLED=false
ENABLE_OBSERVABILITY=false
ENABLE_A365_OBSERVABILITY_EXPORTER=false
N8N_EVAL_COLLECTIONS_ENABLED=true
N8N_CONFIG_EVALS_ENABLED=true
N8N_INSTANCE_AI_NODE_CONTEXT_ENABLED=true
N8N_INSTANCE_AI_NODE_USAGE_ENABLED=true
N8N_INSTANCE_AI_FOLDER_EXPLORATION_ENABLED=true
N8N_WORKFLOWS_GROUPS_WITH_TRIGGERS_ENABLED=true
N8N_WORKFLOWS_GROUPS_WITH_MANY_BOUNDARIES_ENABLED=true
N8N_FEATURE_FLAG_OVERRIDES='{"091_instance_ai_computer_use":"variant","114_instance_activity_context":true,"116_at_mentions_enabled":true,"109_instance_ai_conversation_history":"variant","111_instance_ai_progressive_building":"variant","111_context_preferences":"variant","118_instance_ai_setup_overhaul":"variant","120_credential_descriptions":true,"124_instance_ai_concise_style":"variant"}'

# v2: explicit "not dropped" values (kept so no env var is missing)
N8N_DISABLED_MODULES=
N8N_VERIFIED_PACKAGES_ENABLED=true
N8N_INSTANCE_AI_TEMPLATES_DISABLED=false
N8N_INSTANCE_REPORTING_BASE_URL=
N8N_INSTANCE_REPORTING_AUTH_TOKEN=
